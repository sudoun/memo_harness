{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Posterior memory delayed outcome",
  "type": "object",
  "required": ["observation_id", "true_relation"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "true_relation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "outcome_event_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512
    },
    "labeled_at": {"type": ["number", "null"]},
    "correction_reason": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512
    }
  },
  "additionalProperties": false
}
